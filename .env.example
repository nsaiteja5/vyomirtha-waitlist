# ════════════════════════════════════════════════════════════════════
# 🌐 1. ENVIRONMENT & MODE SWITCHES
# ════════════════════════════════════════════════════════════════════
# Set to 'true' for local testing (simulates X login & payments with 0 credentials)
# Set to 'false' for production (real X OAuth & Cashfree Payment Gateway)
TEST_ENV=false

# Cashfree Gateway Environment: 'TEST' (sandbox) or 'PROD' (live)
CASHFREE_ENV=PROD

# ════════════════════════════════════════════════════════════════════
# 🔗 2. APPLICATION & API URLS
# ════════════════════════════════════════════════════════════════════
# Public frontend URL (e.g. https://vyomirtha.com or http://localhost:5173)
VITE_APP_URL=https://vyomirtha.com

# Local SSL switch: set 'true' if running local HTTPS certificates
VITE_ENABLE_HTTPS=false

# FastAPI backend port
API_PORT=8000

# ════════════════════════════════════════════════════════════════════
# 🗄️ 3. FIREBASE REALTIME DATABASE
# ════════════════════════════════════════════════════════════════════
VITE_FIREBASE_DATABASE_URL=https://vyomirtha-default-rtdb.asia-southeast1.firebasedatabase.app

# ════════════════════════════════════════════════════════════════════
# 🐦 4. X (TWITTER) OAUTH 2.0 CREDENTIALS
# ════════════════════════════════════════════════════════════════════
# Callback in X Developer Portal: ${VITE_APP_URL}/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# ════════════════════════════════════════════════════════════════════
# 💳 5. CASHFREE PAYMENT GATEWAY
# ════════════════════════════════════════════════════════════════════
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# ════════════════════════════════════════════════════════════════════
# 🔐 6. SECURITY & SESSION MANAGEMENT
# ════════════════════════════════════════════════════════════════════
JWT_SECRET=generate_a_random_32_character_hex_key_here
