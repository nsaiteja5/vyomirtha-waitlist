# Optional server endpoint that accepts { email, source } JSON and responds with 2xx.
VITE_WAITLIST_API_URL=

# A live hosted checkout URL (for example, a Stripe Payment Link). Never collect
# card data in this application unless the payment provider's PCI-safe component is used.
VITE_FOUNDING_CHECKOUT_URL=

# Only set these to values that are live, accurate, and approved for display.
VITE_FOUNDING_PRICE=
VITE_FOUNDING_SEATS_REMAINING=
